string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(settings_dir "${CMAKE_CURRENT_BINARY_DIR}/view-state-test-${suffix}")
foreach(mode write peek read)
	execute_process(COMMAND "${TEST_PROGRAM}" ${mode} "${settings_dir}" RESULT_VARIABLE result)
	if(NOT result EQUAL 0)
		file(REMOVE_RECURSE "${settings_dir}")
		message(FATAL_ERROR "UI state ${mode} failed: ${result}")
	endif()
endforeach()
file(REMOVE_RECURSE "${settings_dir}")
